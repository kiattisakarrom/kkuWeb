# Copy to back/.env. This file is never included in a Docker image.
USER_SUPREAM=
PASSWORD_SUPREAM=
SERVER_SUPREAM=
DATABASE_SUPREAM=
JWT_SECRET=

# Optional OPD medication / LAB source.
USER_HOSPITALKKH=
PASSWORD_HOSPITALKKH=
SERVER_HOSPITALKKH=
DATABASE_HOSPITALKKH=

# Enable only when the ER OPD source is reachable. Disabled leaves a visible
# partial-data notice on both the ER report page and its PDF; no MySQL probe.
REPORT_REQUISITION_ER_OPD_ENABLED=false

# OPD radiology requisition (Windows OPD42). Prepared only until enabled.
# Independent of both ER flags; importing the reader never connects to MySQL.
REPORT_REQUISITION_OPDRAD_ENABLED=false

# IHOS DUE reads the hospital restricted-drug API. Keep the key on the backend.
IHOS_DUE_API_KEY=

# Original Windows drug-picture folder. Missing/unreadable folders use bundled pictures.
# Empty also uses bundled pictures; a missing drug picture falls back to no_picture.png.
# For local development only. Docker uses a read-only Linux mount instead.
# To use a complete picture folder in Docker, set DRUG_IMAGE_HOST_DIR on the host.
CHECKOUT_DRUG_IMAGE_DIR=
